# Copia este archivo como .env y pon tus datos. El .env no se sube a git.

# Conexión a PostgreSQL (la guía usa el puerto 5434)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=adso_fincas
DB_USER=postgres
DB_PASSWORD=

# Clave para firmar los tokens JWT, en Base64 y de mínimo 32 bytes.
# Se puede generar en PowerShell con:
# [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }) -as [byte[]])
JWT_SECRET=
# Duración del token en milisegundos (86400000 = 24 horas)
JWT_EXPIRATION=86400000
