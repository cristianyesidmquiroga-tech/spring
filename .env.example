# Copia este archivo como .env y pon tus datos. El .env no se sube a git.

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5434
DB_NAME=porteria_spring
DB_USER=postgres
DB_PASSWORD=

# Clave para firmar los tokens JWT, en Base64 y de mínimo 32 bytes.
# Se puede generar en PowerShell con:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SECRET=

# Administrador principal. Se crea al arrancar si no existe y nunca se le
# cambia la contraseña si ya existe. Debe cambiarla en su primer ingreso.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DOCUMENTO=

# Solo desarrollo: contraseña de los usuarios de prueba (uno por rol y cargo).
# Si se deja vacía no se crean.
DEMO_PASSWORD=

# Carpeta donde se guardan las fotos de perfil (fuera de cualquier carpeta pública)
CARPETA_FOTOS=datos/fotos

# Datos que imprime el carnet: sin la variable se usan los del centro de Velez (descomentar para cambiarlos)
# CARNET_REGIONAL=Regional Santander
# CARNET_CENTRO=Centro de Gestion Agroempresarial del Oriente
# CARNET_ASEGURADORA=Aseguradora Aurora
# CARNET_ASEGURADORA_TEL=601-7443718 Op. 1
# CARNET_POLIZA=100603
# Reasignar perfiles del carnet por cargo, ej: Celador:FUNCIONARIO
CARNET_PERFILES=

# Correo saliente: verificación, recuperación, bienvenida, comunicados. Sin SMTP_HOST no se envía nada.
SMTP_HOST=
# 465 cifra desde el inicio, 587 usa STARTTLS; 25 va en claro y solo sirve contra un relé local
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CONTRASENA=
# Dirección que aparece como remitente (sin ella se usa SMTP_USUARIO)
SMTP_REMITENTE=
SMTP_NOMBRE_REMITENTE=Sistema de Acceso SENA
# Solo para forzarlo: ssl, starttls o ninguno. Un valor distinto se ignora y se deduce del puerto
SMTP_CIFRADO=
# rele (por defecto) o directo. Directo entrega al servidor del destinatario por el puerto 25 y sin
# SPF/DKIM/DMARC termina en spam; si falla, con SMTP_RESPALDO_RELE=true se intenta por el relé
SMTP_MODO=rele
SMTP_RESPALDO_RELE=true
# Dirección pública del frontend, para los enlaces de los correos
URL_SISTEMA=http://localhost:5173

# Registro público: dominios de correo permitidos separados por coma (vacío = cualquiera)
DOMINIOS_REGISTRO=
# Desafío anti-bot del registro y la recuperación (prueba de trabajo, sin servicios externos)
CAPTCHA_ACTIVO=false
CAPTCHA_DIFICULTAD=60000

# Respaldo mensual en Excel del mes anterior (día 1 a las 00:00:10)
CARPETA_RESPALDOS=datos/respaldos
# true borra de la base lo respaldado, solo después de verificar que el archivo se puede leer
PURGAR_TRAS_RESPALDO=false
